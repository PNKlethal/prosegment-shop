# ╔══════════════════════════════════════╗
# ║  Скопируйте в .env и заполните       ║
# ╚══════════════════════════════════════╝

# Сервер
PORT=3000
NODE_ENV=production

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prosegment
DB_USER=postgres
DB_PASS=postgres123
DB_SCHEMA=public

# Админка — придумайте логин и пароль
ADMIN_LOGIN=admin
ADMIN_PASS=admin123
# Секрет для сессий (любая длинная строка)
SESSION_SECRET=prosegment-secret-key-2024-test

# Email — SMTP.ru (бесплатно до 500 писем/день)
# Зарегистрируйтесь на smtp.ru, получите логин и пароль
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=825d74c29ae109
SMTP_PASS=6e34374005db99
EMAIL_FROM="ПРО-сегмент <test@prosegment.ru>"

# URL сайта (для ссылок в письмах)
SITE_URL=https://prosegment.ru

# Папка для загружаемых файлов
UPLOAD_DIR=./uploads

# Максимальный размер файла (в МБ)
MAX_FILE_SIZE=100
