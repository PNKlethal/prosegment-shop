# ╔══════════════════════════════════════╗
# ║  Скопируйте в .env и заполните       ║
# ╚══════════════════════════════════════╝

# Сервер
PORT=3000
NODE_ENV=production

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=prosegment
DB_USER=prosegment_user
DB_PASS=ПРИДУМАЙТЕ_ПАРОЛЬ_БД

# Админка — придумайте логин и пароль
ADMIN_LOGIN=admin
ADMIN_PASS=ПРИДУМАЙТЕ_ПАРОЛЬ_АДМИНКИ
# Секрет для сессий (любая длинная строка)
SESSION_SECRET=ДЛИННАЯ_СЛУЧАЙНАЯ_СТРОКА_32_СИМВОЛА

# Email — SMTP.ru (бесплатно до 500 писем/день)
# Зарегистрируйтесь на smtp.ru, получите логин и пароль
SMTP_HOST=smtp.smtp.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ВАШ_ЛОГИН@smtp.ru
SMTP_PASS=ВАШ_ПАРОЛЬ_SMTP
EMAIL_FROM="ПРО-сегмент <noreply@prosegment.ru>"

# URL сайта (для ссылок в письмах)
SITE_URL=https://prosegment.ru

# Папка для загружаемых файлов
UPLOAD_DIR=./uploads

# Максимальный размер файла (в МБ)
MAX_FILE_SIZE=100
